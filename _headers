/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://customer.moovs.app; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://koast-chat.euburaga.workers.dev https://fonts.googleapis.com https://fonts.gstatic.com; frame-src https://customer.moovs.app; worker-src 'self'; manifest-src 'self'; upgrade-insecure-requests
